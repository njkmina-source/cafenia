# --------------------------------------------------------
# پیکربندی امنیتی وب سرور آپاچی مخصوص سی پنل (cPanel)
# --------------------------------------------------------

# جلوگیری از پیمایش دایرکتوری‌ها و نمایش فایل‌های پوشه
Options -Indexes

# تعیین فایل پیش‌فرض لود شونده دایرکتوری
DirectoryIndex index.php

# محافظت در برابر حملات تزریق اسکریپت و ارتقا امنیت هدرها
<IfModule mod_headers.c>
    Header set X-XSS-Protection "1; mode=block"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-Content-Type-Options "nosniff"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# غیرفعال کردن اجرای اسکریپت‌های PHP در پوشه آپلودها (بسیار حیاتی)
# این کار مانع از هک و آپلود وب‌شل توسط هکرها از طریق فرم‌های تصاویر می‌شود
<FilesMatch "\.(php|php4|php5|php7|php8|phtml|pl|py|jsp|asp|sh|cgi)$">
    # در صورتی که هاست آپاچی باشد اجرای پی‌اچ‌پی در این دایرکتوری غیرفعال می‌شود
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
